# 统一换行符为 LF
* text=auto

# 源代码文件使用 LF 换行符
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.tars text eol=lf
*.cmake text eol=lf
*.make text eol=lf

# 脚本文件
*.sh text eol=lf
*.py text eol=lf

# 文档
*.md text eol=lf
*.txt text eol=lf

# 图片、二进制文件不转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.so binary
*.a binary
