// ========== DB.tars ==========
// V0.5 数据库服务接口
// - V0.4.5: 账号/角色 MySQL 持久化
// - V0.5: 高频数据 Redis 持久化

#include "GameDemoBase.tars"

module GameDemo
{
    // ========== 高频数据错误码 ==========
    const int ERR_KV_NOT_FOUND = 6001;

    // ========== 高频玩家数据 (位置快照) ==========
    struct PlayerKVData
    {
        0 require long playerId;       // 玩家ID (主键 Key)
        1 require int level;           // 等级
        2 require float x;             // 位置X
        3 require float y;             // 位置Y
        4 require float z;             // 位置Z
        5 require int sceneId;         // 场景ID
        6 optional long updateTime;    // 更新时间
    };

    // ========== KV 服务接口 ==========
    interface KVServant
    {
        // 保存单个玩家数据 (Tars 自动生成 async_xxx 异步版本)
        int savePlayerData(PlayerKVData data);
        
        // 批量保存
        int batchSavePlayerData(vector<PlayerKVData> dataList);
        
        // 获取玩家数据
        int getPlayerData(long playerId, out PlayerKVData data);

        // 删除玩家数据
        int deletePlayerData(long playerId);

        // 批量获取
        int batchGetPlayerData(vector<long> playerIds, out vector<PlayerKVData> dataList);
    };

    // ========== 数据库服务接口 ==========
    interface DBServant
    {
        // ========== 账号操作 ==========
        
        // 创建账号
        // 返回 accountId = playerId
        int createAccount(string username, string password, out long accountId);
        
        // 根据用户名获取账号信息
        int getAccountByName(string username, out AccountInfo account);
        
        // 根据 ID 获取账号信息
        int getAccountById(long accountId, out AccountInfo account);
        
        // 检查账号是否存在
        int accountExists(string username, out bool exists);
        
        // 更新账号信息（包含角色数据）
        int updateAccount(AccountInfo account);
        
        // ========== 角色操作（一账户一角色模式）==========
        
        // 初始化角色（首次登录创建角色）
        // 账号已存在，只需填充角色相关字段
        int initCharacter(long accountId, string playerName, int job, 
                         out AccountInfo character);
        
        // 获取角色信息（通过 accountId/playerId）
        int getCharacter(long playerId, out AccountInfo character);
        
        // 更新角色信息
        int updateCharacter(AccountInfo character);
    };
};
