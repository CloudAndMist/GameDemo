
module GD
{

// 玩家在线信息
struct PlayerInfo
{
    0 require long playerId;       // 玩家ID
    1 require string openId;       // 原始openId
    2 require float x;            // 位置X
    3 require float y;            // 位置Y
    5 require long enterTime;     // 进入场景时间戳
};

// 游戏服务接口 (客户端调用)
interface GameServant
{
    // 登录
    int login(string openId, out long sessionId, out long playerId);
    
    // 移动 (2D坐标，移除Z轴)
    int move(long sessionId, float x, float y);
    
    // 进入场景
    int enterScene(long sessionId, out long playerId, out vector<PlayerInfo> players);
    
    // 登出
    int logout(long sessionId);
};

};