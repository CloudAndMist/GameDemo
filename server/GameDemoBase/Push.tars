// ========== Push.tars ==========
// V0.4.5 推送接口定义
// 
// 架构说明:
// - Scene2LobbyPush: SceneServer → LobbyServer 的推送接口
// - Lobby2ClientPush: LobbyServer → 客户端 的推送接口（通过 PushCallback 机制）
//
// 使用方式:
// - SceneServer: 通过 stringToProxy<Scene2LobbyPushPrx>("LobbyServer.Scene2LobbyPushObj") 调用
// - Client: 调用 tars_set_push_callback() 注册 Lobby2ClientPush 回调
// - LobbyServer: 收到 Scene2LobbyPush 回调后，通过 CurrentPtr 推送消息给客户端

#include "GameDemoBase.tars"

module GameDemo
{
    // ========== 玩家掉线通知 ==========
    struct PlayerOfflineNotify
    {
        0 require long playerId;
        1 require long timestamp;
    };

    // ========== Scene2LobbyPush 接口 (SceneServer → LobbyServer) ==========
    // V0.4.5: 使用 PlayerBaseInfo 替代 PlayerInfo（减少数据传输）

    interface Scene2LobbyPush
    {
        // 玩家进入场景通知
        // notifyList: Scene 内除新玩家外的所有 playerId
        int onPlayerEnter(vector<long> notifyList, long playerId, int sceneId, PlayerBaseInfo player);

        // 玩家移动通知
        // notifyList: Scene 内其他玩家的 playerId
        int onPlayerMove(vector<long> notifyList, long playerId, int sceneId, float x, float y, float z);

        // 玩家离开场景通知
        // notifyList: Scene 内其他玩家的 playerId
        int onPlayerLeave(vector<long> notifyList, long playerId, int sceneId);

        // 玩家掉线通知
        // notifyList: Scene 内其他玩家的 playerId
        int onPlayerOffline(vector<long> notifyList, long playerId, int sceneId);

        // 玩家重连通知
        // notifyList: Scene 内其他玩家的 playerId
        int onPlayerOnline(vector<long> notifyList, long playerId, int sceneId, PlayerBaseInfo player);
    };

    // ========== Lobby2ClientPush 接口 (客户端实现，通过 PushCallback 机制被调用) ==========
    // 客户端实现此接口来接收服务端推送的消息
    // 使用 TARS PushCallback 机制:
    //   1. 客户端调用 proxy->tars_set_push_callback(callback)
    //   2. LobbyServer 通过 CurrentPtr 推送消息
    // 注意: 使用 out 参数以便服务端推送数据

    interface Lobby2ClientPush
    {
        // 推送玩家进入
        int onPlayerEnter(out PlayerEnterNotify notify);

        // 推送玩家移动
        int onPlayerMove(out PlayerMoveNotify notify);

        // 推送玩家离开
        int onPlayerLeave(out PlayerLeaveNotify notify);

        // 推送玩家掉线
        int onPlayerOffline(out PlayerOfflineNotify notify);

        // 推送玩家重连上线
        int onPlayerOnline(out PlayerEnterNotify notify);
    };
};
