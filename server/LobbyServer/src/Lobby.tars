// ========== Lobby.tars ==========
// LobbyServer 大厅服务接口
// 整合账号相关功能和客户端连接管理
//
// 注意: 共用的请求/响应结构已移至 GameDemoBase/GameDemoBase.tars

#include "GameDemoBase.tars"
#include "Push.tars"
#include "Scene.tars"

module GameDemo
{
    // ========== 请求/响应结构 ==========

    // 登录请求
    struct LoginReq
    {
        0 require string qqNumber;
        1 require string password;
    };

    // 登录响应
    struct LoginRsp
    {
        0 require int ret;
        1 optional string msg;
        2 optional long accountId;
        3 optional long playerId;
        4 optional string qqNumber;
        5 optional long sessionKey;      // V0.4: 会话密钥
    };

    // 注册请求
    struct RegisterReq
    {
        0 require string qqNumber;
        1 require string password;
    };

    // 注册响应
    struct RegisterRsp
    {
        0 require int ret;
        1 optional string msg;
        2 optional long accountId;
    };

    // 创建角色请求
    struct CreateRoleReq
    {
        0 require long accountId;
        1 require string roleName;
        2 require int job;
    };

    // 创建角色响应
    struct CreateRoleRsp
    {
        0 require int ret;
        1 optional string msg;
        2 optional RoleInfo role;
        3 optional long playerId;
    };

    // 获取角色列表请求
    struct GetRoleListReq
    {
        0 require long accountId;
    };

    // 获取角色列表响应
    struct GetRoleListRsp
    {
        0 require int ret;
        1 optional string msg;
        2 optional vector<RoleInfo> roles;
    };

    // 选择角色请求
    struct SelectRoleReq
    {
        0 require long accountId;
        1 require long roleId;
    };

    // 选择角色响应
    struct SelectRoleRsp
    {
        0 require int ret;
        1 optional string msg;
        2 optional long playerId;
        3 optional RoleInfo role;
    };

    // ========== Lobby 服务接口 ==========

    interface LobbyServant
    {
        // 登录
        int login(LoginReq req, out LoginRsp rsp);

        // 注册账号
        int registerAccount(RegisterReq req, out RegisterRsp rsp);

        // 创建角色
        int createRole(CreateRoleReq req, out CreateRoleRsp rsp);

        // 获取角色列表
        int getRoleList(GetRoleListReq req, out GetRoleListRsp rsp);

        // 选择角色
        int selectRole(SelectRoleReq req, out SelectRoleRsp rsp);

        // 心跳
        int heartbeat(HeartBeatReq req);

        // 进入场景 (转发给 SceneServer)
        int enterScene(long playerId, int sceneId, out EnterSceneRsp rsp);

        // 移动 (转发给 SceneServer)
        int move(MoveReq req, out MoveRsp rsp);

        // 离开场景 (转发给 SceneServer)
        int leaveScene(long playerId, int sceneId, out LeaveSceneRsp rsp);

        // 注册推送回调 (客户端调用以接收服务器推送)
        int registerPush(long playerId);
    };
};
// Note: Scene2LobbyPush 接口定义在 GameDemoBase/Push.tars 中
// LobbyServer 需要实现该接口供 SceneServer 调用
