// ========== Scene.tars ==========
// SceneServer 场景服务接口
// 架构原则: Client 不直接连接 SceneServer，所有请求通过 LobbyServer 转发
// 推送机制: SceneServer 直接调用 LobbyServer 回调接口，无需注册

#include "GameDemoBase.tars"

module GameDemo
{
    // SceneServant 接口定义
    // 注意: 共用的请求/响应结构已移至 GameDemoBase/GameDemoBase.tars
    interface SceneServant
    {
        // 进入场景 (LobbyServer 调用)
        int enterScene(EnterSceneReq req, out EnterSceneRsp rsp);

        // 移动 (LobbyServer 调用)
        int move(MoveReq req, out MoveRsp rsp);

        // 心跳 (LobbyServer 调用)
        int heartbeat(HeartBeatReq req);

        // 获取场景玩家列表 (LobbyServer 调用)
        int getScenePlayers(long playerId, int sceneId, out GetScenePlayersRsp rsp);

        // 离开场景 (LobbyServer 调用)
        int leaveScene(LeaveSceneReq req, out LeaveSceneRsp rsp);
    };
};
